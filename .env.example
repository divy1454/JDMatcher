# ===================================================================
# JDMatcher Enterprise — Environment Variables
# ===================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!
# ===================================================================

# Database Connection (Supabase PostgreSQL / Pooled or Direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jdmatcher"

# Fastify Server
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Authentication (MUST change in production! Use a 64+ char random string)
JWT_SECRET="super-secret-jwt-key-jdmatcher-enterprise-2026-production"

# AI Provider (Google Gemini)
# Leave empty for offline simulation mode, or paste your key:
GEMINI_API_KEY=""

# Super Admin Initial Credentials (Used during db:seed)
SUPER_ADMIN_EMAIL="admin@jdmatcher.internal"
SUPER_ADMIN_PASSWORD="ChangeMeInProd123!"
SUPER_ADMIN_NAME="Platform Super Admin"

# Production CORS Origins (comma-separated)
# Example: https://jdmatcher-app.onrender.com,chrome-extension://abcdef123456
CORS_ORIGINS=""

# Job Hunter (all optional). Company career sites work without keys.
# JSearch adds LinkedIn / Indeed / Dice / ZipRecruiter results (free plan: 200 requests/month, 1-2 per search)
JSEARCH_API_KEY=""
# rapidapi (default) or openwebninja
JSEARCH_PROVIDER=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# JSON array of career page links that replaces the default list, e.g.
# '["https://jobs.lever.co/acme","https://acme.wd5.myworkdayjobs.com/External"]'
JOB_FINDER_WATCHLIST=""

# Frontend Public API URL (set in frontend/.env.local or Render env vars)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
